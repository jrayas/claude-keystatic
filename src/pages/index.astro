---
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const sections = [
  { label: 'Blog', href: `${base}/blog`, description: 'Dated posts on how this garden is built.' },
  { label: 'Documentation', href: `${base}/docs`, description: 'Reference material, organised by category.' },
  { label: 'Cheatsheets', href: `${base}/cheatsheets`, description: 'Quick-lookup syntax and command references.' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Digital Garden</title>
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased">
    <main class="max-w-2xl mx-auto px-4 sm:px-8 py-24">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-3 h-3 rounded-full bg-indigo-500"></div>
        <span class="font-semibold tracking-tight">Digital Garden</span>
      </div>
      <h1 class="text-4xl font-bold tracking-tight mb-10">Notes, docs, and cheatsheets.</h1>
      <div class="grid gap-4 sm:grid-cols-3">
        {sections.map((section) => (
          <a
            href={section.href}
            class="block p-5 rounded-lg border border-slate-200 bg-white hover:border-indigo-300 hover:shadow-sm transition"
          >
            <h2 class="font-semibold text-lg mb-1">{section.label}</h2>
            <p class="text-sm text-slate-500">{section.description}</p>
          </a>
        ))}
      </div>
    </main>
  </body>
</html>
