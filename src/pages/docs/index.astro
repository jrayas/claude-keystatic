---
import { getCollection } from 'astro:content';
import '../../styles/global.css';

const entries = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const categories = [...new Set(entries.map((e) => e.data.category))];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Documentation | Digital Garden</title>
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased">
    <main class="max-w-2xl mx-auto px-4 sm:px-8 py-16">
      <h1 class="text-3xl font-bold tracking-tight mb-8">Documentation Hub</h1>
      {categories.map((category) => (
        <section class="mb-8">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-500 mb-3">{category}</h2>
          <ul class="space-y-2">
            {entries.filter((e) => e.data.category === category).map((entry) => (
              <li>
                <a href={`${base}/docs/${entry.id}`} class="text-lg font-medium text-indigo-700 hover:underline">
                  {entry.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </main>
  </body>
</html>
